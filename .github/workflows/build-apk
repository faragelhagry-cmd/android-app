name: Build Android APK
on:
  workflow_dispatch: {}
  push:
    branches: [ main ]
    tags: [ 'v*' ]

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Check required project files
        run: |
          for f in package.json capacitor.config.json patch_manifest.py www/index.html www/app.js assets/icon-only.png; do
            if [ ! -s "$f" ]; then
              echo "::error::Required project file is missing or empty: $f"
              exit 1
            fi
          done

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Read version and keep app updater in sync
        shell: bash
        run: |
          VERSION="$(node -p "require('./package.json').version")"
          if [[ ! "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            echo "::error::package.json version must be MAJOR.MINOR.PATCH (got: $VERSION)"
            exit 1
          fi

          # If this build is triggered by a version tag, the tag must match package.json.
          if [[ "$GITHUB_REF" == refs/tags/v* ]]; then
            TAG_VERSION="${GITHUB_REF_NAME#v}"
            if [[ "$TAG_VERSION" != "$VERSION" ]]; then
              echo "::error::Tag v$TAG_VERSION does not match package.json version $VERSION"
              exit 1
            fi
          fi

          # The updater version is injected from package.json during every build,
          # so the app never keeps advertising a stale APP_VERSION.
          python3 - "$VERSION" <<'PYCODE'
          from pathlib import Path
          import re, sys
          version = sys.argv[1]
          p = Path("www/app.js")
          s = p.read_text(encoding="utf-8")
          s, n = re.subn(
              r"""const APP_VERSION\s*=\s*['"][^'"]+['"]\s*;""",
              "const APP_VERSION='" + version + "';",
              s,
              count=1,
          )
          if n != 1:
              raise SystemExit("Could not find exactly one APP_VERSION declaration in www/app.js")
          p.write_text(s, encoding="utf-8")
          print(f"Updater APP_VERSION synchronized to {version}")
          PYCODE

      - run: npm install

      - name: Bundle offline PDF generator for Android
        run: cp node_modules/html2pdf.js/dist/html2pdf.bundle.min.js www/html2pdf.bundle.min.js

      - name: Add Android platform
        run: npx cap add android

      - name: Set Android versionCode and versionName
        shell: bash
        run: |
          VERSION="$(node -p "require('./package.json').version")"
          IFS='.' read -r MAJOR MINOR PATCH <<< "$VERSION"
          VERSION_CODE=$((MAJOR * 1000000 + MINOR * 1000 + PATCH))
          python3 - "$VERSION" "$VERSION_CODE" <<'PYCODE'
          from pathlib import Path
          import re, sys
          version, code = sys.argv[1], sys.argv[2]
          p = Path("android/app/build.gradle")
          s = p.read_text(encoding="utf-8")
          s, n1 = re.subn(r"versionCode\s+\d+", "versionCode " + code, s, count=1)
          s, n2 = re.subn(r"""versionName\s+['"][^'"]*['"]""", 'versionName "' + version + '"', s, count=1)
          if n1 != 1 or n2 != 1:
              raise SystemExit("Could not set Android versionCode/versionName in app/build.gradle")
          p.write_text(s, encoding="utf-8")
          print(f"Android versionName={version}, versionCode={code}")
          PYCODE

      - name: Patch Android project (camera, open .accdata files, minSdk)
        run: |
          python3 patch_manifest.py
          sed -i 's/minSdkVersion = [0-9]*/minSdkVersion = 23/' android/variables.gradle

      - name: Prepare showroom logo
        run: |
          cp assets/icon-only.png assets/icon.png
          test -s assets/icon.png

      - name: Generate Android launcher icons
        run: |
          npx --yes @capacitor/assets generate --android --iconBackgroundColor '#ffffff' --iconBackgroundColorDark '#ffffff'
          test -s android/app/src/main/res/mipmap-mdpi/ic_launcher.png
          test -s android/app/src/main/res/mipmap-hdpi/ic_launcher.png
          test -s android/app/src/main/res/mipmap-xhdpi/ic_launcher.png
          test -s android/app/src/main/res/mipmap-xxhdpi/ic_launcher.png
          test -s android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png

      - name: Restore saved Android debug keystore
        env:
          ANDROID_DEBUG_KEYSTORE_BASE64: ${{ secrets.ANDROID_DEBUG_KEYSTORE_BASE64 }}
        shell: bash
        run: |
          mkdir -p "$HOME/.android"
          if [ -z "$ANDROID_DEBUG_KEYSTORE_BASE64" ]; then
            echo "::error::Missing ANDROID_DEBUG_KEYSTORE_BASE64 secret"
            exit 1
          fi
          printf '%s' "$ANDROID_DEBUG_KEYSTORE_BASE64" | base64 --decode > "$HOME/.android/debug.keystore"
          test -s "$HOME/.android/debug.keystore"
          KEYSTORE_INFO="$(keytool -list -v -keystore "$HOME/.android/debug.keystore" -storepass android -alias androiddebugkey)"
          printf '%s\n' "$KEYSTORE_INFO"
          KEYSTORE_SHA256="$(printf '%s\n' "$KEYSTORE_INFO" | awk -F': ' '/SHA256:/{gsub(":", "", $2); print tolower($2); exit}')"
          if [[ -z "$KEYSTORE_SHA256" ]]; then
            echo "::error::Could not read SHA-256 fingerprint from saved keystore"
            exit 1
          fi
          echo "KEYSTORE_SHA256=$KEYSTORE_SHA256" >> "$GITHUB_ENV"

      - run: npx cap sync android

      - name: Configure Gradle to use the saved debug keystore
        shell: bash
        run: |
          python3 <<'PYCODE'
          from pathlib import Path
          import re

          p = Path("android/app/build.gradle")
          s = p.read_text(encoding="utf-8")

          # Explicitly configure the debug signing identity to use the restored
          # keystore. This prevents Gradle from silently signing with another key.
          signing_block = """signingConfigs {
                  debug {
                      storeFile file(System.getProperty("user.home") + "/.android/debug.keystore")
                      storePassword "android"
                      keyAlias "androiddebugkey"
                      keyPassword "android"
                  }
              }
          """

          if not re.search(r"\bsigningConfigs\s*\{", s):
              s, n = re.subn(r"\bandroid\s*\{", lambda m: m.group(0) + "\n    " + signing_block, s, count=1)
              if n != 1:
                  raise SystemExit("Could not locate android { block in app/build.gradle")
          else:
              # If a signingConfigs block already exists, ensure its debug entry
              # points to the restored keystore instead of leaving it unchanged.
              debug_signing = re.compile(r"debug\s*\{[^{}]*\}", re.S)
              match = debug_signing.search(s[s.find("signingConfigs"):])
              if match:
                  start = s.find("signingConfigs") + match.start()
                  end = s.find("signingConfigs") + match.end()
                  s = s[:start] + signing_block.strip() + s[end:]
              else:
                  s = re.sub(r"(signingConfigs\s*\{)", r"\1\n    " + signing_block, s, count=1)

          # Ensure the debug build type actually selects signingConfigs.debug.
          build_types = re.search(r"\bbuildTypes\s*\{", s)
          if not build_types:
              raise SystemExit("Could not locate buildTypes { block in app/build.gradle")
          tail = s[build_types.end():]
          debug_block = re.search(r"\bdebug\s*\{", tail)
          if debug_block:
              absolute = build_types.end() + debug_block.end()
              close = s.find("}", absolute)
              if close < 0:
                  raise SystemExit("Could not locate closing brace for debug build type")
              body = s[absolute:close]
              if re.search(r"signingConfig\s+signingConfigs\.debug", body):
                  pass
              elif re.search(r"signingConfig\s+", body):
                  body = re.sub(r"signingConfig\s+[^\s]+", "signingConfig signingConfigs.debug", body, count=1)
                  s = s[:absolute] + body + s[close:]
              else:
                  s = s[:absolute] + "\n            signingConfig signingConfigs.debug\n        " + s[absolute:]
          else:
              # Add a dedicated debug build type if the template has none.
              insert_at = build_types.end()
              s = s[:insert_at] + "\n        debug { signingConfig signingConfigs.debug }\n" + s[insert_at:]

          p.write_text(s, encoding="utf-8")
          print("Gradle debug signing configured to use ~/.android/debug.keystore")
          PYCODE

      - name: Build APK
        run: |
          chmod +x android/gradlew
          cd android
          ./gradlew assembleDebug

      - name: Verify APK signature and print certificate fingerprint
        run: |
          APK=android/app/build/outputs/apk/debug/app-debug.apk
          APKSIGNER=$(find "$ANDROID_HOME/build-tools" -type f -name apksigner | sort -V | tail -1)
          if [ -z "$APKSIGNER" ]; then
            echo "::error::apksigner was not found"
            exit 1
          fi
          SIGNATURE_INFO="$("$APKSIGNER" verify --verbose --print-certs "$APK")"
          printf '%s\n' "$SIGNATURE_INFO" | tee apk-signature.txt
          APK_SHA256="$(printf '%s\n' "$SIGNATURE_INFO" | awk -F': ' '/Signer #1 certificate SHA-256 digest:/{gsub(":", "", $2); print tolower($2); exit}')"
          if [[ -z "$APK_SHA256" || "$APK_SHA256" != "$KEYSTORE_SHA256" ]]; then
            echo "::error::APK signer certificate does not match the saved keystore certificate"
            echo "Saved keystore SHA-256: $KEYSTORE_SHA256"
            echo "APK signer SHA-256: $APK_SHA256"
            exit 1
          fi
          echo "APK signing certificate matches the saved keystore."

      - name: Name APK with version number
        shell: bash
        run: |
          VERSION="$(node -p "require('./package.json').version")"
          cp android/app/build/outputs/apk/debug/app-debug.apk "Accounting-Android-${VERSION}.apk"
          echo "APK_NAME=Accounting-Android-${VERSION}.apk" >> "$GITHUB_ENV"

      - uses: actions/upload-artifact@v4
        with:
          name: Accounting-Reader-APK
          path: ${{ env.APK_NAME }}

      - name: Publish APK to GitHub Release
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: ${{ env.APK_NAME }}
          name: الإصدار ${{ github.ref_name }}
          body: تحديث تطبيق الموبايل — نزّل ملف الـ APK المرفق وثبّته فوق النسخة القديمة.
